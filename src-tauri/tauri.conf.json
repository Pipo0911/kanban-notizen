{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kanban Notizen",
  "version": "1.2.0",
  "identifier": "ch.seewer.kanbannotizen",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Kanban Notizen",
        "width": 1400,
        "height": 900,
        "minWidth": 820,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "Philipp Seewer",
    "category": "Productivity",
    "shortDescription": "Kanban-Notizen mit Terminen und Zeiterfassung",
    "longDescription": "Notizen in Spalten organisieren, mit Kategorien, Prioritäten, Labels, Erinnerungen und Zeiterfassung. Läuft komplett offline.",
    "copyright": "© 2026 Philipp Seewer",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "German"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "de-DE"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUyRTlDNjJFMEJBQzM1QjkKUldTNU5hd0xMc2JwVXE3ZnlWR3g0SzhTQXFpL0UwOGMyandvSDlON1ExTXAwemc4bDRUVDdRUWYK",
      "endpoints": [
        "https://github.com/Pipo0911/kanban-notizen/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
